# Electron's installer (@electron/get) resolves its download base through
# mirrorVar(): the key below reaches it as npm_config_electron_mirror.
# Verified byte-faithful: the mirror's SHASUMS256.txt hash for
# electron-v44.3.0-win32-x64.zip equals the one shipped in electron's own
# checksums.json, which @electron/get validates against.
electron_mirror=https://registry.npmmirror.com/-/binary/electron/
