{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.1.1",
  "private": true,
  "description": "DSH Desktop — a Windows desktop shell for DeepSeek Harness (supervises a child harness process)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABccgh/dsh-desktop.git"
  },
  "homepage": "https://github.com/ABccgh/dsh-desktop#readme",
  "bugs": {
    "url": "https://github.com/ABccgh/dsh-desktop/issues"
  },
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test test/",
    "smoke": "node bin/smoke.mjs",
    "smoke:dev": "node bin/smoke.mjs --dev",
    "icon": "electron tools/make-icon.mjs",
    "pack": "node bin/pack.mjs",
    "surface": "node bin/dsh-surface.mjs",
    "installer": "electron-builder --win nsis --config electron-builder.yml",
    "shortcut": "pwsh -NoProfile -File bin/shortcut.ps1"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.0"
  },
  "license": "MIT"
}
